        <mxCell id="c21" value="5" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
